# ============================================================
# GiftTracker — конфигурация окружения
# Скопируйте в .env и заполните: cp .env.example .env
# ============================================================

# ----- Telegram (ОБЯЗАТЕЛЬНО) -----
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF-PLACEHOLDER-REPLACE-ME
# ID администраторов (узнать: @userinfobot). Формат JSON-массива:
# один админ — [123456789], несколько — [123456789,987654321]
ADMIN_IDS=[123456789]
# Публичный HTTPS-URL витрины Mini App (static/index.html)
# Именно этот адрес указывается в BotFather -> /newapp
MINI_APP_URL=https://your-domain.example.com/

# ----- База данных -----
# SQLite WAL в примонтированном томе (переживает пересборку контейнеров)
DATABASE_URL=sqlite+aiosqlite:///./data/gift_tracker.db

# ----- Источник рыночных данных -----
# mock        — автономный генератор (работает из коробки, без внешних API)
# tonapi      — флоры коллекций с tonapi.io (нужны адреса ниже, при ошибке -> mock)
# giftdataset — реальные флоры TGMrkt/Getgems/Portals из публичного датасета
#               TelegramGifts + реальные sale-лоты Getgems через TonAPI (без токенов)
MARKET_SOURCE=mock
TONAPI_BASE_URL=https://tonapi.io/v2
TONAPI_KEY=
# JSON: имя подарка -> адрес TON-коллекции (только для MARKET_SOURCE=tonapi)
TONAPI_COLLECTIONS={}

# Публичный датасет флоров (Market_SOURCE=giftdataset)
GIFTDATASET_URL=https://raw.githubusercontent.com/ssamy2/TelegramGiftsAssests/main/Gifts_Details.json
GIFTDATASET_TTL_SEC=120
# Сколько страниц по 100 NFT забирать на коллекцию за проход TonAPI
TONAPI_SCAN_PAGES=5
TONAPI_LISTINGS_TTL_SEC=60

# ----- Монетизация (Telegram Stars) -----
PRO_MONTH_STARS=150
PRO_LIFETIME_STARS=999
PRO_MONTH_DAYS=30
# Как часто снимать is_pro у истекших подписок (секунды)
PRO_EXPIRY_CHECK_INTERVAL_SEC=3600

# ----- Монетизация (крипта через Crypto Pay @CryptoBot) -----
# Токен приложения: @CryptoBot -> Crypto Pay -> Create App -> Copy Token.
# Пусто = кнопки крипто-оплаты скрыты, работает только Stars.
CRYPTO_PAY_TOKEN=
CRYPTO_API_BASE=https://pay.crypt.bot/api
# Валюта инвойса (USDT = цена в $); цены тарифов в USD
CRYPTO_ASSET=USDT
CRYPTO_MONTH_USD=3
CRYPTO_LIFETIME_USD=20
# Как часто фоново сверять оплаченные инвойсы (секунды)
CRYPTO_POLL_INTERVAL_SEC=120

# ----- Ограничения FREE-тарифа -----
FREE_PUSH_DELAY_SEC=45
FREE_ALERTS_LIMIT=1

# ----- Экономика арбитража -----
GETGEMS_FEE=0.05
TON_GAS=0.08
TON_USD_RATE=5.20

# ----- Движок снайпера -----
SNIPER_THRESHOLD_PCT=15.0
HOT_THRESHOLD_PCT=30.0
SCAN_INTERVAL_SEC=5.0
MARKET_CACHE_TTL_SEC=5.0
FEED_HISTORY_LIMIT=50
# L1-кэш дедупликации в памяти; L2 — таблица seen_lots в SQLite
SEEN_LOTS_CACHE_SIZE=500
# Сколько дней хранить отметки лотов (защита от повторных пушей после рестарта)
SEEN_LOTS_RETENTION_DAYS=7

# ----- Надёжность и эксплуатация -----
# Период WAL checkpoint (секунды)
WAL_CHECKPOINT_INTERVAL_SEC=300
# Уровень логов: DEBUG/INFO/WARNING/ERROR/CRITICAL
LOG_LEVEL=INFO
# text — человекочитаемый, json — структурные логи (Loki/Filebeat)
LOG_FORMAT=text
# Heartbeat бота: файл-маркер, который читают /api/health и Docker healthcheck
BOT_HEARTBEAT_FILE=./data/bot_heartbeat.json
BOT_HEARTBEAT_INTERVAL_SEC=30
# Если heartbeat старше этого возраста — бот считается мёртвым
BOT_HEARTBEAT_STALE_SEC=120

# ----- Рассылка и API -----
BROADCAST_DELAY_SEC=0.05
NOTIFIER_CONCURRENCY=25
# JSON-массив origins для CORS: все — ["*"], конкретные — ["https://a.com","https://b.com"]
API_ALLOWED_ORIGINS=["*"]
