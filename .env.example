# ============================================================
# GiftTracker — конфигурация окружения
# Скопируйте в .env и заполните: cp .env.example .env
# ============================================================

# ----- Telegram (ОБЯЗАТЕЛЬНО) -----
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF-PLACEHOLDER-REPLACE-ME
# ID администраторов (узнать: @userinfobot). Формат JSON-массива:
# один админ — [123456789], несколько — [123456789,987654321]
ADMIN_IDS=[123456789]
# Публичный HTTPS-URL витрины Mini App (static/index.html)
# Именно этот адрес указывается в BotFather -> /newapp
MINI_APP_URL=https://your-domain.example.com/

# ----- База данных -----
# SQLite WAL в примонтированном томе (переживает пересборку контейнеров)
DATABASE_URL=sqlite+aiosqlite:///./data/gift_tracker.db

# ----- Источник рыночных данных -----
# mock   — автономный генератор (работает из коробки, без внешних API)
# tonapi — флоры коллекций с tonapi.io (нужны адреса ниже, при ошибке -> mock)
MARKET_SOURCE=mock
TONAPI_BASE_URL=https://tonapi.io/v2
TONAPI_KEY=
# JSON: имя подарка -> адрес TON-коллекции (только для MARKET_SOURCE=tonapi)
TONAPI_COLLECTIONS={}

# ----- Монетизация (Telegram Stars) -----
PRO_MONTH_STARS=150
PRO_LIFETIME_STARS=999
PRO_MONTH_DAYS=30

# ----- Ограничения FREE-тарифа -----
FREE_PUSH_DELAY_SEC=45
FREE_ALERTS_LIMIT=1

# ----- Экономика арбитража -----
GETGEMS_FEE=0.05
TON_GAS=0.08
TON_USD_RATE=5.20

# ----- Движок снайпера -----
SNIPER_THRESHOLD_PCT=15.0
HOT_THRESHOLD_PCT=30.0
SCAN_INTERVAL_SEC=5.0
MARKET_CACHE_TTL_SEC=5.0
FEED_HISTORY_LIMIT=50
SEEN_LOTS_CACHE_SIZE=500

# ----- Рассылка и API -----
BROADCAST_DELAY_SEC=0.05
NOTIFIER_CONCURRENCY=25
# JSON-массив origins для CORS: все — ["*"], конкретные — ["https://a.com","https://b.com"]
API_ALLOWED_ORIGINS=["*"]
