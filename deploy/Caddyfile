# GiftTracker — Caddy reverse proxy с автоматическим HTTPS.
# Подставляется через docker-compose.prod.yml; домен берется из .env (DOMAIN).
#
# Локально: caddy validate --config deploy/Caddyfile --adapter caddyfile

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy api:8000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
